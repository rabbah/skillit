{
  "name": "skillit",
  "version": "0.1.0",
  "type": "module",
  "description": "Generic agent that dispatches user prompts to admin-uploaded skill files stored in Redis.",
  "scripts": {
    "dev": "bun --watch agent/index.ts",
    "start": "bun agent/index.ts"
  },
  "main": "./agent/index.ts",
  "dependencies": {
    "@astropods/adapter-core": "latest",
    "@astropods/adapter-mastra": "latest",
    "@astropods/messaging": "latest",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "@mastra/otel-exporter": "latest",
    "@opentelemetry/exporter-trace-otlp-proto": "latest",
    "@tavily/core": "^0.7.3",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.9.3"
  }
}
